---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Masters from "../components/Masters.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import Blog from "../components/Blog.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import BookingDriver from "../components/BookingDriver.jsx";
---

<Layout
  title="Harmony — салон краси"
  description="Harmony — салон краси на Подолі. Запис онлайн на стрижку, фарбування, манікюр та догляд."
>
  <div class="app" style='--font-display: "Open Sans", Georgia, serif;'>
    <Nav />
    <Hero />

    <BookingDriver client:visible />

    <Services />
    <Masters />
    <Gallery />
    <Reviews />
    <Blog />
    <Contacts />
    <Footer />
  </div>

  <script>
    // Scroll-reveal, ported from the old usePageAnimations hook. Runs once
    // over the whole (now mostly static) page — not React-specific, so it
    // doesn't need to live inside the booking island.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const itemSelector =
      ".hero-copy, .hero-art, .booking-widget, .sec-head, .filter-row, .service-card, .master-card, .gallery-grid img, .review-card, .blog-card, .contact-info, .map";

    const sections = Array.from(document.querySelectorAll(".hero, .section"));

    sections.forEach((section) => {
      const items = Array.from(section.querySelectorAll(itemSelector));
      items.forEach((item, index) => {
        item.classList.add("reveal-item");
        item.style.setProperty("--reveal-delay", `${index * 120}ms`);
        if (reduced) item.classList.add("is-visible");
      });
    });

    if (!reduced) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.querySelectorAll(".reveal-item").forEach((item) => item.classList.add("is-visible"));
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.15 }
      );
      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Layout>
